# Copy to .env and fill in. Never commit .env, and never paste these values into chat,
# an issue or a pull request. Use a separate key for each environment.

# Music and speech-to-text. Limit the key to those endpoints and give it a credit quota.
ELEVENLABS_API_KEY=

# Lyrics writer and judge. Set a monthly spend limit on the account.
ANTHROPIC_API_KEY=

# Supabase (staging and production are separate projects).
DATABASE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Cost controls. These mirror mm.pipeline.Limits.
DAILY_BUDGET_USD=5
GENERATION_ENABLED=true
