# Copy to .env and fill in. Never commit .env, and never paste these values into chat,
# an issue or a pull request. Use a separate key for each environment.

# Music: Lyria 3.5 through the Gemini API. Billing must be on, because Lyria has no free tier.
# Set a budget alert on the Cloud project. See decision 20.
GEMINI_API_KEY=

# Speech-to-text, used to check what was actually sung against the approved words.
# Not chosen yet, and not the same thing as the music key. See decision 20.
TRANSCRIBER_API_KEY=

# Lyrics writer and judge. Set a monthly spend limit on the account.
ANTHROPIC_API_KEY=

# Supabase (staging and production are separate projects).
DATABASE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Participant codes for the web page, separated by commas. Make them with: mm codes
# A code is the only key to a family's songs. Treat this line like a password.
PARTICIPANT_CODES=

# Cost controls. These mirror mm.pipeline.Limits.
DAILY_BUDGET_USD=5
GENERATION_ENABLED=true
